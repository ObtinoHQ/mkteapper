    "custom_testominal_Rw9XHL": {
      "type": "Custom-Testominal",
      "blocks": {
        "testimonial_mmwLXY": {
          "type": "testimonial",
          "settings": {
            "review_text": "Bestilte en tæppe hos dem på tilbud. Pludselig opstod der forvirring på deres lager om den var udsolgt eller ej.\nEfter en kort og hurtig \"samtale\" via mail, fik jeg muligheden til at bestille tæppet igen til samme tilbudspris.\nFik pengene retur fra første m, og overskydende penge fra min anden odre retur efter et par dage.\nTæpper i rigtig god kvalitet.",
            "customer_name": "Frank L."
          }
        },
        "testimonial_UdNTGV": {
          "type": "testimonial",
          "settings": {
            "review_text": "Jeg har købt tæpper hos MK tæpper i flere år og de har aldrig skuffet. Helt fra da min lille datter var til enhjørning tæppe til hun blev ældre og vi købte en af deres soft touch til hendes værelse. Jeg har også købt et mørkt med mønster til kontorer, og i vore stue har vi deres Soft touch tæppe og pudebetræk i 2 forskellige farver.\nLevering, kvalitet og service tip top. I får de varmeste anbefalinger herfra!",
            "customer_name": "Louise C."
          }
        },
        "testimonial_BCxRm4": {
          "type": "testimonial",
          "settings": {
            "review_text": "Tæpperne er ikke helt som på billedet på hjemmesiden, de er heldigvis betydelig pænere i virkeligheden.\nGod service hele vejen igennem med mails fra dem under leveringsprocessen så man kan følge med. Selv kort tid efter de er leveret kom der mail fra dem om at de nu var leveret.\n\nLidt lang leveringstid fordi tæpperne kom fra Tyskland hvor de åbenbart har deres lager.",
            "customer_name": "B. Lund"
          }
        },
        "testimonial_UwCzJx": {
          "type": "testimonial",
          "settings": {
            "review_text": "Bestilte et super soft deluxe taupe tæppe på hjemmesiden. Inden der var gået 24t havde jeg fået leveret varen. Jeg er meget tilfreds med produktets kvalitet, håndtering af handelen og hurtig levering!\n\nDet er absolut ikke sidste gang jeg vil handle hos jer 😀",
            "customer_name": "Tenna J."
          }
        },
        "testimonial_MrMVat": {
          "type": "testimonial",
          "settings": {
            "review_text": "Stort udvalg af flotte tæpper til gode priser. Hjemmesiden er nem at finde rundt i og tæppet så præcis ud som på billederne. Fragten var upåklagelig og varen var forsvarligt pakket ind. Stor tilfredshed herfra 👌😊",
            "customer_name": "Ahmed Kaawach"
          }
        }
      },
