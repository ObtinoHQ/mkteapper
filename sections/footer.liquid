{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<script src="{{ 'footer.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign socials = 'facebook,instagram,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo'
  assign socials_arr = socials | split: ','
  assign has_social_icons = false
  for social in socials_arr
    assign setting_key = 'social_' | append: social | append: '_link'
    if settings[setting_key] != blank
      assign has_social_icons = true
      break
    endif
  endfor
-%}
<style>
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>
<footer class="footer color-{{ section.settings.color_scheme }} section-{{ section.id }}">
  {% render 'divider',
    show_divider: section.settings.show_section_divider,
    divider_width: section.settings.divider_width
  %}
  <div class="footer__wrapper section--padding">
    {%- if section.blocks.size > 0 -%}
      <div
        class="footer__top page-width page-width--{{ section.settings.container }}"
        style="--total-items: {{ section.blocks.size }};"
      >
        <div class="footer__top-wrapper flex flex-wrap">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div
                class="footer-block footer-block--{{ block.type }} f-column w-full{% if block.type == 'newsletter' %} lg:order-none{% if block.settings.order_first %} order-first{% else %} order-last{% endif %}{% endif %}{% if block.settings.show_divider %} has-border relative{% endif %}"
                style="--col-width:{{ block.settings.block_width | divided_by: 100.0 }};{% if block.type == 'newsletter' %}--form-width: {{ block.settings.form_width }}px;{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- case block.type -%}
                  {%- when 'contact_information' -%}
                    {% liquid
                      assign address = block.settings.address
                      assign working_hours = block.settings.working_hours
                      assign email = block.settings.email
                      assign phone = block.settings.phone
                      assign content_empty = false
                      if address == blank and working_hours == blank and email == blank and phone == blank
                        assign content_empty = true
                      endif

                      assign tag = 'div'
                      if block.settings.heading != blank
                        assign tag = 'details'
                      endif
                    %}
                    {% if content_empty != true %}
                      <{{ tag }}
                        id="Details-{{ block.id }}-{{ section.id }}"
                        {% if tag == 'details' %}
                          is="footer-details"
                          open
                          data-open-default="{{ block.settings.open_default }}"
                        {% endif %}
                        class="accordion-details footer-accordion-details"
                      >
                        {%- if block.settings.heading != blank -%}
                          <summary class="accordion-details__summary flex items-center justify-between gap-2">
                            <h3 class="footer-block__heading inline-richtext {{ block.settings.heading_size }}">
                              {{- block.settings.heading -}}
                            </h3>
                            <span class="flex items-center lg:hidden">
                              {%- render 'icon-plus-toggle', size: 'small' -%}
                            </span>
                          </summary>
                        {%- endif -%}
                        <div class="accordion-details__content footer-block__contact-info footer-info text-subtext">
                          {% unless address == blank %}
                            <div class="footer-info__item footer-info__address">
                              <svg
                                width="20"
                                height="20"
                                viewBox="0 0 20 20"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path d="M10 10.625C11.3807 10.625 12.5 9.50571 12.5 8.125C12.5 6.74429 11.3807 5.625 10 5.625C8.61929 5.625 7.5 6.74429 7.5 8.125C7.5 9.50571 8.61929 10.625 10 10.625Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M16.25 8.125C16.25 13.75 10 18.125 10 18.125C10 18.125 3.75 13.75 3.75 8.125C3.75 6.4674 4.40848 4.87769 5.58058 3.70558C6.75269 2.53348 8.3424 1.875 10 1.875C11.6576 1.875 13.2473 2.53348 14.4194 3.70558C15.5915 4.87769 16.25 6.4674 16.25 8.125Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                              <span>{{ address }}</span>
                            </div>
                          {% endunless %}
                          {% unless email == blank %}
                            <div class="footer-info__item footer-info__email">
                              <svg
                                width="20"
                                height="20"
                                viewBox="0 0 20 20"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path d="M2.5 4.375H17.5V15C17.5 15.1658 17.4342 15.3247 17.3169 15.4419C17.1997 15.5592 17.0408 15.625 16.875 15.625H3.125C2.95924 15.625 2.80027 15.5592 2.68306 15.4419C2.56585 15.3247 2.5 15.1658 2.5 15V4.375Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M17.5 4.375L10 11.25L2.5 4.375" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                              <a href="mailto:{{ email }}">{{ email }}</a>
                            </div>
                          {% endunless %}
                          {% unless phone == blank %}
                            <div class="footer-info__item footer-info__phone">
                              <svg
                                width="20"
                                height="20"
                                viewBox="0 0 20 20"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path d="M15 16.875L15 3.125C15 2.43464 14.4404 1.875 13.75 1.875L6.25 1.875C5.55964 1.875 5 2.43464 5 3.125L5 16.875C5 17.5654 5.55964 18.125 6.25 18.125H13.75C14.4404 18.125 15 17.5654 15 16.875Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M10 5.625C10.5178 5.625 10.9375 5.20527 10.9375 4.6875C10.9375 4.16973 10.5178 3.75 10 3.75C9.48223 3.75 9.0625 4.16973 9.0625 4.6875C9.0625 5.20527 9.48223 5.625 10 5.625Z" fill="currentColor"/>
                              </svg>
                              <a href="tel:{{ phone }}">{{ phone }}</a>
                            </div>
                          {% endunless %}
                          {% unless working_hours == blank %}
                            <div class="footer-info__item footer-info__working-hours">
                              <svg
                                width="20"
                                height="20"
                                viewBox="0 0 20 20"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path d="M10 17.5C14.1421 17.5 17.5 14.1421 17.5 10C17.5 5.85786 14.1421 2.5 10 2.5C5.85786 2.5 2.5 5.85786 2.5 10C2.5 14.1421 5.85786 17.5 10 17.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M10 5.625V10H14.375" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                              <span>{{ working_hours }}</span>
                            </div>
                          {% endunless %}
                        </div>
                      </{{ tag }}>
                    {% endif %}
                  {%- when 'menu' -%}
                    {% liquid
                      assign block_title = block.settings.heading
                      if block_title == blank
                        assign block_title = linklists[block.settings.menu].title
                      endif

                      assign tag = 'div'
                      if block_title != blank
                        assign tag = 'details'
                      endif
                    %}
                    {%- if block.settings.menu != blank -%}
                      <{{ tag }}
                        id="Details-{{ block.id }}-{{ section.id }}"
                        {% if tag == 'details' %}
                          is="footer-details"
                          open
                          data-open-default="{{ block.settings.open_default }}"
                        {% endif %}
                        class="accordion-details footer-accordion-details"
                      >
                        {%- if block_title != blank -%}
                          <summary class="accordion-details__summary flex items-center justify-between gap-2">
                            <h3 class="footer-block__heading inline-richtext {{ block.settings.heading_size }}">
                              {{- block_title -}}
                            </h3>
                            <span class="flex items-center lg:hidden">
                              {%- render 'icon-plus-toggle', size: 'small' -%}
                            </span>
                          </summary>
                        {%- endif -%}
                        <ul class="accordion-details__content linklist linklist--vertical list-unstyled">
                          {%- for link in block.settings.menu.links -%}
                            <li class="reversed-link">
                              <a
                                href="{{ link.url }}"
                                class="text-subtext block"
                              >
                                <span class="reversed-link__text">
                                  {{ link.title }}
                                </span>
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </{{ tag }}>
                    {%- endif -%}
                  {%- when 'image_text' -%}
                    {%- liquid
                      assign tag = 'div'
                      if block.settings.heading != blank and block.settings.layout == 'image_top'
                        assign tag = 'details'
                      endif
                    -%}
                    {%- case block.settings.layout -%}
                      {%- when 'image_top' -%}
                        {% render 'footer-image-text-top', block: block, tag: tag %}
                      {%- when 'image_left' -%}
                        {% render 'footer-image-text-left', block: block %}
                      {%- when 'image_overlay' -%}
                        {% render 'footer-image-text-overlay', block: block %}
                    {%- endcase -%}
                  {%- when 'newsletter' -%}
                    <div class="footer-newsletter text-{{ block.settings.newsletter_text_alignment }}">
                      {%- if block.settings.heading != blank -%}
                        <h3 class="footer-block__heading inline-richtext {{ block.settings.heading_size }}">
                          {{- block.settings.heading -}}
                        </h3>
                      {%- endif -%}
                      {%- if block.settings.newsletter_description != blank -%}
                        <div class="footer-newsletter__description rte text-subtext">
                          {{ block.settings.newsletter_description }}
                        </div>
                      {%- endif -%}
                      <div class="footer-newsletter__form">
                        {% render 'newsletter-form',
                          custom_id: block.id,
                          button_style: block.settings.button_style,
                          button_icon: section.settings.button_icon
                        %}
                      </div>
                      {%- if block.settings.newsletter_term != blank -%}
                        <div class="footer-newsletter__term rte text-subtext">
                          {{ block.settings.newsletter_term }}
                        </div>
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {% endif %}
    <div class="footer__bottom page-width page-width--{{ section.settings.container }}">
      {% liquid
        assign enable_country_selector = false
        assign enable_language_selector = false
        assign show_social = false

        if section.settings.enable_country_selector and localization.available_countries.size > 1
          assign enable_country_selector = true
        endif

        if section.settings.enable_language_selector and localization.available_languages.size > 1
          assign enable_language_selector = true
        endif

        if section.settings.show_social and has_social_icons
          assign show_social = true
        endif
      %}
      {% if enable_country_selector or enable_language_selector or show_social or section.settings.payment_enable %}
        <div class="footer__bottom-row flex justify-between items-end{% if section.settings.footer_layout == "reverse" %} flex-row-reverse{% endif %}{% if section.settings.show_sperator_line %} show-separator-line{% endif %}">
          <div class="{% if section.settings.footer_layout == "reverse" %}flex flex-wrap gap-6{% else %}grid gap-5{% endif %}">
            <div class="footer__localization relative z-2 flex items-center">
              {%- if enable_country_selector -%}
                {% render 'country-selector', position: 'up', plain: true, form_id: section.id %}
              {%- endif -%}

              {%- if enable_language_selector -%}
                {% render 'language-selector', position: 'up', plain: true, form_id: section.id %}
              {%- endif -%}
            </div>

            {%- if section.settings.payment_enable -%}
              <div class="footer__payment">
                <span class="visually-hidden">{{ 'general.payment.methods' | t }}</span>
                <ul class="list list-payment" role="list">
                  {%- for type in shop.enabled_payment_types -%}
                    <li class="list-payment__item">
                      {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                    </li>
                  {%- endfor -%}
                  <li class="list-payment__item">
                    <!-- VIABILL SVG -->
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="38"
                      height="24"
                      viewBox="0 0 38 24"
                      role="img"
                      aria-labelledby="pi-viabill"
                    >
                      <title id="pi-viabill">ViaBill</title><path fill="#000" opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#5a00ff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><g fill="#fff"><path d="M24.048 8.885a.676.676 0 0 0-.676.676v4.877a.676.676 0 0 0 1.352 0V9.561a.676.676 0 0 0-.676-.676ZM22.419 13.133a1.691 1.691 0 0 0-1.031-1.52 1.3 1.3 0 0 0 .443-1.016c0-1.139-.964-1.665-2.13-1.665h-1.612a.592.592 0 0 0 0 1.183h1.612c.517 0 .78.263.78.622s-.263.578-.8.578h-.647a.57.57 0 1 0 .021 1.139h1.239a.752.752 0 0 1 .812.765c0 .571-.688.71-1.038.719a.572.572 0 0 0-.11 1.136 2.361 2.361 0 0 0 .392.04 2.166 2.166 0 0 0 1.131-.281 1.864 1.864 0 0 0 .938-1.7ZM12.129 8.885a.676.676 0 0 1 .625.935l-2.016 4.877a.676.676 0 0 1-.625.418.676.676 0 0 1-.625-.935l2.016-4.877a.677.677 0 0 1 .625-.418ZM17.568 15.114a.677.677 0 0 1-.625-.418l-1.637-4.168-1.637 4.168a.676.676 0 0 1-.625.418.676.676 0 0 1-.625-.935l1.922-4.649a1.045 1.045 0 0 1 .965-.645 1.045 1.045 0 0 1 .965.645l1.922 4.649a.676.676 0 0 1-.625.935ZM4.677 8.885a.677.677 0 0 1 .625.418l1.637 4.168 1.637-4.168a.677.677 0 0 1 .625-.418.676.676 0 0 1 .625.935l-1.922 4.649a1.045 1.045 0 0 1-.965.645 1.044 1.044 0 0 1-.965-.645L4.052 9.82a.676.676 0 0 1 .625-.935ZM33.409 13.884h-1.637V9.565a.681.681 0 1 0-1.361 0v4.91a.591.591 0 0 0 .591.591h2.406a.591.591 0 0 0 .591-.591.591.591 0 0 0-.59-.591ZM28.876 13.884h-1.637V9.565a.681.681 0 1 0-1.361 0v4.91a.591.591 0 0 0 .591.591h2.407a.591.591 0 0 0 .591-.591.591.591 0 0 0-.591-.591Z"/></g>
                    </svg>
                  </li>

                  <!-- Anyday -->
                  <li class="list-payment__item">
                    <!-- ANYDAY SVG -->
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="38"
                      height="24"
                      viewBox="0 0 38 24"
                      fill="none"
                      role="img"
                      aria-labelledby="pi-anyday"
                    >
                      <title id="pi-anyday">Anyday</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z" fill="#000"/><path d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32z" fill="#fff"/><path d="M5.713 13.737H4.391l.75-2.14a1.75 1.75 0 00-2.298.172L2 10.916a2.932 2.932 0 013.55-.487L6.754 7H8.03l2.363 6.737H9.07l-.459-1.341a2.934 2.934 0 01-2.429-.03l-.469 1.37zm.862-2.52a1.75 1.75 0 001.644.033l-.827-2.423-.817 2.39zm16.13 2.612c.594 0 1.077-.25 1.378-.609v.336c0 .1.08.18.179.18h1.07V7h-1.249v2.575c-.3-.323-.766-.545-1.359-.545-1.03 0-2.217.766-2.217 2.4 0 1.624 1.232 2.4 2.199 2.4zm.247-1.163c-.693 0-1.222-.535-1.222-1.246 0-.71.529-1.236 1.222-1.236.675 0 1.168.554 1.168 1.236 0 .683-.493 1.246-1.168 1.246zm5.08 1.163c.594 0 1.077-.25 1.378-.609v.336c0 .1.08.18.179.18h1.07V9.124h-1.07a.18.18 0 00-.179.18v.272c-.301-.323-.766-.545-1.36-.545-1.03 0-2.216.766-2.216 2.4 0 1.624 1.232 2.4 2.199 2.4zm.247-1.163c-.693 0-1.222-.535-1.222-1.245 0-.711.529-1.237 1.222-1.237.675 0 1.168.554 1.168 1.237 0 .682-.493 1.245-1.168 1.245zM13.565 8.942c-.72 0-1.268.317-1.569.686v-.322c0-.1-.08-.181-.178-.181h-.944v4.616h1.287v-2.427c0-.821.383-1.301 1.049-1.301.647 0 .948.424.948 1.227v2.501h1.287v-2.575c0-1.725-.922-2.224-1.88-2.224zm2.932 7.046h.95c.196 0 .371-.12.443-.305l2.578-6.572h-1.32l-1.07 2.897-1.144-2.897h-1.339l1.85 4.497-.948 2.38zM32.979 16h-.95l.949-2.38-1.85-4.497h1.338l1.144 2.898 1.07-2.898H36l-2.577 6.572a.477.477 0 01-.444.305z" fill="#212930"/>
                    </svg>
                  </li>

                  <!-- ViaBill -->

                  <!-- Klarna -->
                  <li class="list-payment__item">
                    <!-- KLARNA SVG -->
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      role="img"
                      width="38"
                      height="24"
                      viewBox="0 0 38 24"
                      aria-labelledby="pi-klarna"
                      fill="none"
                    >
                      <title id="pi-klarna">Klarna</title><rect width="38" height="24" rx="2" fill="#FFA8CD"/><rect x=".5" y=".5" width="37" height="23" rx="1.5" stroke="#000" stroke-opacity=".07"/><path d="M30.62 14.755c-.662 0-1.179-.554-1.179-1.226 0-.673.517-1.226 1.18-1.226.663 0 1.18.553 1.18 1.226 0 .672-.517 1.226-1.18 1.226zm-.33 1.295c.565 0 1.286-.217 1.686-1.068l.04.02c-.176.465-.176.742-.176.81v.11h1.423v-4.786H31.84v.109c0 .069 0 .346.175.81l-.039.02c-.4-.85-1.121-1.068-1.687-1.068-1.355 0-2.31 1.088-2.31 2.522 0 1.433.955 2.521 2.31 2.521zm-4.788-5.043c-.643 0-1.15.228-1.56 1.068l-.039-.02c.175-.464.175-.741.175-.81v-.11h-1.423v4.787h1.462V13.4c0-.662.38-1.078.995-1.078.614 0 .917.356.917 1.068v2.532h1.462v-3.046c0-1.088-.838-1.869-1.989-1.869zm-4.963 1.068l-.039-.02c.176-.464.176-.741.176-.81v-.11h-1.424v4.787h1.463l.01-2.304c0-.673.35-1.078.926-1.078.156 0 .282.02.429.06v-1.464c-.644-.139-1.22.109-1.54.94zm-4.65 2.68c-.664 0-1.18-.554-1.18-1.226 0-.673.516-1.226 1.18-1.226.662 0 1.179.553 1.179 1.226 0 .672-.517 1.226-1.18 1.226zm-.332 1.295c.565 0 1.287-.217 1.687-1.068l.038.02c-.175.465-.175.742-.175.81v.11h1.424v-4.786h-1.424v.109c0 .069 0 .346.175.81l-.038.02c-.4-.85-1.122-1.068-1.687-1.068-1.356 0-2.311 1.088-2.311 2.522 0 1.433.955 2.521 2.31 2.521zm-4.349-.128h1.463V9h-1.463v6.922zM10.136 9H8.644c0 1.236-.751 2.343-1.892 3.134l-.448.317V9h-1.55v6.922h1.55V12.49l2.564 3.43h1.892L8.293 12.64c1.121-.82 1.852-2.096 1.843-3.639z" fill="#0B051D"/>
                    </svg>
                  </li>
                  <!-- MK: EAN (offentlig betaling) and GLS shipping -->
                  <li class="list-payment__item mk-footer-logo">
                    <img src="{{ 'mk-logo-ean.png' | asset_url }}" alt="EAN – offentlig betaling" width="38" height="24" loading="lazy">
                  </li>
                  <li class="list-payment__item mk-footer-logo">
                    <img src="{{ 'mk-logo-gls.png' | asset_url }}" alt="GLS" width="38" height="24" loading="lazy">
                  </li>
                </ul>
              </div>
            {%- endif -%}
          </div>

          {%- if show_social -%}
            {%- liquid
              assign button_style = 'btn btn--icon-circle ' | append: section.settings.social_button_style
            -%}
            {%- render 'social-icons', class: 'footer__list-social', item_class: button_style, size: 'large' -%}
          {%- endif -%}
        </div>
      {% endif %}
      <div class="footer__bottom-row flex justify-between items-start">
        <div class="footer__copyright">


          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer__follow-on-shop">
              {% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
              {% # theme-check-disable %}
              {{ shop | login_button: action: 'follow' }}
              {% # theme-check-enable %}
            </div>
          {%- endif -%}
        </div>
        <div class="footer__info flex items-center">
          {% if section.settings.footer_bottom_menu != blank %}
            <ul class="linklist linklist--horizontal list-unstyled">
              {% for link in linklists[section.settings.footer_bottom_menu].links %}
                <li>
                  <a href="{{ link.url }}" class="reversed-link">{{ link.title | escape }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
      {%- liquid
        assign bar_bg = '#1c1c1c'
        assign bar_text = '#ffffff'
        assign bar_border = 'rgba(255, 255, 255, 0.2)'
        if section.settings.bottom_bar_color == 'white'
          assign bar_bg = '#ffffff'
          assign bar_text = '#1c1c1c'
          assign bar_border = 'rgba(28, 28, 28, 0.2)'
        endif
      -%}
   <div class="footer__bottom-row" style="margin-top: 0px; padding: 0px; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
  <div style="margin: 0; opacity: 0.7; font-size: 13.5px; color: {{ bar_text }};">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
  </div>

  
    </span>
  </a>
</div>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "t:sections.footer.name",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "menu",
      "name": "t:general.menu.name",
      "settings": [
        {
          "type": "range",
          "id": "block_width",
