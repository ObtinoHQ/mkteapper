                      </svg>
                    </li>

                    <!-- Anyday -->
                    <li class="list-payment__item">
                      <!-- ANYDAY SVG -->
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="38"
                        height="24"
                        viewBox="0 0 38 24"
                        fill="none"
                        role="img"
                        aria-labelledby="pi-anyday"
                      >
                        <title id="pi-anyday">Anyday</title><path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z" fill="#000"/><path d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32z" fill="#fff"/><path d="M5.713 13.737H4.391l.75-2.14a1.75 1.75 0 00-2.298.172L2 10.916a2.932 2.932 0 013.55-.487L6.754 7H8.03l2.363 6.737H9.07l-.459-1.341a2.934 2.934 0 01-2.429-.03l-.469 1.37zm.862-2.52a1.75 1.75 0 001.644.033l-.827-2.423-.817 2.39zm16.13 2.612c.594 0 1.077-.25 1.378-.609v.336c0 .1.08.18.179.18h1.07V7h-1.249v2.575c-.3-.323-.766-.545-1.359-.545-1.03 0-2.217.766-2.217 2.4 0 1.624 1.232 2.4 2.199 2.4zm.247-1.163c-.693 0-1.222-.535-1.222-1.246 0-.71.529-1.236 1.222-1.236.675 0 1.168.554 1.168 1.236 0 .683-.493 1.246-1.168 1.246zm5.08 1.163c.594 0 1.077-.25 1.378-.609v.336c0 .1.08.18.179.18h1.07V9.124h-1.07a.18.18 0 00-.179.18v.272c-.301-.323-.766-.545-1.36-.545-1.03 0-2.216.766-2.216 2.4 0 1.624 1.232 2.4 2.199 2.4zm.247-1.163c-.693 0-1.222-.535-1.222-1.245 0-.711.529-1.237 1.222-1.237.675 0 1.168.554 1.168 1.237 0 .682-.493 1.245-1.168 1.245zM13.565 8.942c-.72 0-1.268.317-1.569.686v-.322c0-.1-.08-.181-.178-.181h-.944v4.616h1.287v-2.427c0-.821.383-1.301 1.049-1.301.647 0 .948.424.948 1.227v2.501h1.287v-2.575c0-1.725-.922-2.224-1.88-2.224zm2.932 7.046h.95c.196 0 .371-.12.443-.305l2.578-6.572h-1.32l-1.07 2.897-1.144-2.897h-1.339l1.85 4.497-.948 2.38zM32.979 16h-.95l.949-2.38-1.85-4.497h1.338l1.144 2.898 1.07-2.898H36l-2.577 6.572a.477.477 0 01-.444.305z" fill="#212930"/>
                      </svg>
                    </li>

                    <!-- ViaBill -->

                    <!-- Klarna -->
                    <li class="list-payment__item">
                      <!-- KLARNA SVG -->
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        role="img"
                        width="38"
                        height="24"
                        viewBox="0 0 38 24"
                        aria-labelledby="pi-klarna"
