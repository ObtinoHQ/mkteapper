{%- liquid
  # MK: the product page has its own sale timer by the price, so two countdowns would show at once
  assign mk_hide_timer = false
  if section.settings.mk_hide_on_product and request.page_type == 'product'
    assign mk_hide_timer = true
  endif
-%}
{%- unless mk_hide_timer -%}
{{ 'component-countdown-timer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'countdown-timer.js' | asset_url }}" defer="defer"></script>
<style>

  .countdown-flex-wrapper {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 20px;
}

.countdown-text {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing:0;
}

.countdown-timer-box {
  display: flex;
  align-items: center;
}
a.countdown-cta-btn span {
  font-size: 14px;
  line-height: normal !important;
  letter-spacing: 0;
}

/* Mobile */
@media (max-width: 768px) {
  a.countdown-cta-btn span {
    font-size: 12px;
   }
  .countdown-flex-wrapper {
            column-gap: 20px;
        text-align: center;
        flex-wrap: wrap;
        row-gap: 5px;
  }

  .countdown-text {
    font-size: 15px;
  }
  a.countdown-cta-btn {
    height: 100%;
    padding: 6px 12px;
}
}

</style>

<section
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
        text-align: center;
  "
>
  <div class="page-width">
<div class="countdown-flex-wrapper">

  {% if section.settings.heading != blank %}
    <div class="countdown-text">
      {{ section.settings.heading }}
    </div>
  {% endif %}

  <div class="countdown-timer-box">
    {%- liquid
      # MK: one sale timer for the header and the product page
      assign timer_type = section.settings.type
      assign timer_duration = section.settings.duration
      assign timer_time = section.settings.time
      if section.settings.mk_use_sale_timer
        assign timer_type = settings.mk_sale_timer_type
        assign timer_duration = settings.mk_sale_timer_duration
        assign timer_time = settings.mk_sale_timer_time
      endif
    -%}
    {% render 'countdown-timer',
      id: section.id,
      type: timer_type,
      duration: timer_duration,
      time: timer_time,
      number_size: section.settings.number_size
    %}
  </div>

  {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_url }}" class="countdown-cta-btn btn btn--primary">
      <span class="btn__text">{{ section.settings.button_label }}</span>
    </a>
  {% endif %}

</div>

</div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "Custom Countdown Section",
  "settings": [
    {
      "type": "checkbox",
      "id": "mk_use_sale_timer",
      "label": "Brug udsalgs-timeren fra temaindstillinger",
      "info": "Temaindstillinger > MK optimering > Udsalgs-timer. Så følger timeren på produktsiden med.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mk_hide_on_product",
      "label": "Skjul på produktsider",
      "info": "Produktsiden har sin egen timer ved prisen.",
      "default": false
    },
    {
  "type": "text",
  "id": "heading",
  "label": "Text before timer",
  "default": "Limited Time Offer Ends In:"
},
{
  "type": "header",
  "content": "Call To Action Button"
},
{
  "type": "text",
  "id": "button_label",
  "label": "Button Label",
  "default": "Shop Now"
},
{
  "type": "url",
  "id": "button_url",
  "label": "Button Link"
},
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },

    {
      "type": "header",
      "content": "Timer Settings"
    },

    {
      "type": "select",
      "id": "type",
      "label": "Timer Type",
      "options": [
        { "value": "evergreen", "label": "Evergreen" },
        { "value": "fixed_time", "label": "Fixed Time" }
      ],
      "default": "evergreen"
    },

    {
      "type": "select",
      "id": "number_size",
      "label": "Number Size",
      "default": "h1",
      "options": [
        { "value": "h5", "label": "H5" },
        { "value": "h4", "label": "H4" },
        { "value": "h3", "label": "H3" },
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" },
        { "value": "hd2", "label": "HD2" },
        { "value": "hd1", "label": "HD1" }
      ]
    },

    {
      "type": "header",
      "content": "Evergreen Settings"
    },

    {
      "type": "select",
      "id": "duration",
      "label": "Evergreen Duration",
      "options": [
        { "value": "every_2_hrs", "label": "Every 2 Hours" },
        { "value": "every_6_hrs", "label": "Every 6 Hours" },
        { "value": "every_12_hrs", "label": "Every 12 Hours" },
        { "value": "every_24_hrs", "label": "Every 24 Hours" },
        { "value": "every_week", "label": "Every Week" },
        { "value": "every_month", "label": "Every Month" }
      ],
      "default": "every_month"
    },

    {
      "type": "header",
      "content": "Fixed Time Settings"
    },

    {
      "type": "text",
      "id": "time",
      "label": "Fixed Time (YYYY/MM/DD HH:MM AM/PM)",
      "default": "2026/12/31 11:59 PM"
    }
  ],
  "presets": [
    {
      "name": "Custom Countdown Section"
    }
  ]
}
{% endschema %}
