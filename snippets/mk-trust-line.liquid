{%- comment -%}
  One line under the buy button: return policy, delivery time and the showroom.

  Accepts:
  - block: {Object} mk_trust_line block
  - product: {Object}
{%- endcomment -%}
{%- liquid
  assign dmin = product.metafields.custom.leveringstid_min.value | default: settings.mk_delivery_min_days
  assign dmax = product.metafields.custom.leveringstid_max.value | default: settings.mk_delivery_max_days
-%}
<p class="mk-trust-line">
  {%- if block.settings.return_text != blank -%}
    <span class="mk-trust-line__item">{% render 'icon-check', size: 'small' %}{{ block.settings.return_text }}</span>
  {%- endif -%}
  {%- if block.settings.show_delivery and dmax != blank -%}
    <span class="mk-trust-line__item">
      {%- render 'icon-truck', size: 'small' -%}
      <span data-mk-delivery data-min="{{ dmin }}" data-max="{{ dmax }}" data-prefix="Levering">
        Levering {{ dmin }}–{{ dmax }} hverdage
      </span>
    </span>
  {%- endif -%}
  {%- if block.settings.showroom_text != blank -%}
    <span class="mk-trust-line__item">
      {%- render 'icon-storefront', size: 'small' -%}
      {%- if block.settings.showroom_link != blank -%}
        <a href="{{ block.settings.showroom_link }}">{{ block.settings.showroom_text }}</a>
      {%- else -%}
        {{ block.settings.showroom_text }}
      {%- endif -%}
    </span>
  {%- endif -%}
</p>
